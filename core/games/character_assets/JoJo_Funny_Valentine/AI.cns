;===============================================================================
; INTELIGENCIA ARTIFICIAL:
;===============================================================================
[Statedef -2]

[State 0, Run]
type = ChangeState
triggerall = statetype = S
triggerall = var(5) = 0
triggerall = stateno != 100
triggerall = stateno != 105
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 100
trigger1 = random < (ailevel * 100)/2
value = ifelse(pos y >= 0,100,0)

[State 0, Run Atras]
type = ChangeState
triggerall = statetype = S
triggerall = var(5) = 0
triggerall = stateno != 100
triggerall = stateno != 105
triggerall = backedgebodydist > 50
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 100 && p2movetype = A
trigger1 = random < (ailevel * 100)/4
value = 105

[State 0, Guard]
type = ChangeState
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = (p2bodydist x < 50 && p2movetype = A) || (enemy,numproj > 0)
trigger1 = random < (ailevel * 100)*2
value = ifelse(statetype = S,132,130)

[State 0, Power Charge]
type = ChangeState
triggerall = power < 5000
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x >= 100
trigger1 = random < (ailevel * 100)/2
value = 195

[State 0, Power Charge End]
type = ChangeState
triggerall = time >= 12
triggerall = stateno = 195
triggerall = ailevel > 0
trigger1 = (p2bodydist x < 50) || (enemy,numproj > 0)
trigger2 = power = 5000
value = 196

[State 0, Ultimate a]
type = ChangeState
triggerall = power > 2000
triggerall = life < 800
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 30
trigger1 = random < (ailevel * 100)
value = 235

[State 0, A]
type = ChangeState
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x <= 20
trigger1 = random < (ailevel * 100)
trigger2 = stateno = 220 = movehit
value = 200

[State 0, A]
type = ChangeState
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = stateno = 200
triggerall = p2bodydist x <= 30
trigger1 = random < (ailevel * 100)
trigger2 = movehit
value = 220

[State 0, B]
type = ChangeState
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x = 50
trigger2 = stateno = 0
trigger3 = stateno = 20
trigger4 = stateno = 100
trigger1 = random < (ailevel * 100)
value = 205

[State 0, DFB]
type = ChangeState
triggerall = power >= 500
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x = [105,999]
trigger1 = random < (ailevel * 100)
value = 210

[State 0, C 1]
type = ChangeState
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 1 && p2bodydist x < 150
triggerall = power >= 500
trigger1 = random < (ailevel * 100)
value = 230

[State 0, C 2]
type = ChangeState
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 1 && p2bodydist x < 150
triggerall = power >= 500
trigger1 = random < (ailevel * 100)
value = 232

[State 0, Teleport]
type = ChangeState
triggerall = power >= 10
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 50
trigger1 = random < (ailevel * 100)
value = 300

[State 0, LEL]
type = ChangeState
triggerall = power >= 500
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x >= 1 
trigger1 = random < (ailevel * 100)
value = 240

[State 0, LIL PUMP]
type = ChangeState
triggerall = power >= 500
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x >= 1
trigger1 = random < (ailevel * 100)
value = 250

[State 0, A Aire]
type = ChangeState
triggerall = statetype = A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 30
triggerall = p2bodydist y > 20
trigger1 = random < (ailevel * 100)
value = 600

[State 0, B Aire]
type = ChangeState
triggerall = statetype = A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x = 50
triggerall = p2bodydist y >= 20
trigger1 = random < (ailevel * 100)
value = 610

[State 0, Ultimate b]
type = ChangeState
triggerall = power > 2000
triggerall = life < 800
triggerall = statetype = S
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 30
trigger1 = random < (ailevel * 100)
value = 236

;---------------------------------------------------------------------------
; Other Sounds
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Pain Sound]
type = playsnd
triggerall = movetype = H && random < 333
trigger1 = alive = 1 && time = 0
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020 || StateNo = 5070 || StateNo = 5100
value = S1,6+random%11
volume = 999

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0



