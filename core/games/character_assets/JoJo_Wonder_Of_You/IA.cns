[Statedef -2]

;AI时停对策开关|;AI time stop countermeasure switch
[State 0, VarSet]
type = VarSet
trigger1 = !ishelper
v = 54
value = 1 ;1 on|打开 / 0 off|关闭

[State -2]
type = RemapPal
trigger1 = 1
source = 1,1
dest = 1,var(4)
ignorehitpause = 1

[State 0, Helper]
type = Helper
triggerall = numhelper(1330) = 0
trigger1 = numhelper(1310) = 1
helpertype = normal ;player
name = "aura a"
ID = 1330
stateno = 1330
pos = 0,0
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 99999999
pausemovetime = 99999999
size.xscale = 1;*const(size.xscale)
size.yscale = 1;*const(size.yscale)

[state 0]
type = palfx
triggerall = roundstate = 2
triggerall = alive
triggerall = life <= lifemax/2
trigger1 = time % (25 + (life / 50)) = 0
time = 40
add = 0, (-66 + floor(life / 15)), (-66 + floor(life / 15))
sinadd = 0, (-66 + floor(life / 15)), (-66 + floor(life / 15)), (-66 + floor(life / 15))
color = 200 + floor(life / 17.6)
ignorehitpause = 1

[State -2]
type = helper
triggerall = var(45) = 0
triggerall = alive
triggerall = life <= lifemax/3
trigger1 = roundstate = 2 
trigger1 = numhelper(8510) = 0
stateno = 8510
id = 8510
pos = 0,Floor((1.33*GameHeight/GameWidth)*-140)
pausemovetime = 999999
supermovetime = 999999
sprpriority = 1
postype = back
ownpal = 1
size.xscale = .125
size.yscale = .125
persistent = 0

[State 0, VarSet]
type = VarSet
trigger1 = life < lifemax/3
v = 45
value = 1

[State 0, LifeAdd]
type = LifeAdd
trigger1 = helper(1450),stateno = 1460 && helper(1450),time = 1
value = -75
kill = 1
ignorehitpause = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = helper(1450),stateno = 1460 && helper(1450),time = 1
value = S5000,0+random%4
volumescale = 255
channel = 0

[State 0, LifeAdd]
type = LifeAdd
trigger1 = helper(1450),stateno = 1455 && helper(1450),time = 1
value = 175
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
triggerall = (stateNo = [191,199])
;trigger1 = var(4) = 0
trigger1 = var(4) = 12 && command = "fwd"
v = 4
value = 0
;persistent = 1

[State 0, Varadd]
type = Varadd
triggerall = (stateNo = [191,199])
triggerall = var(4) < 13
triggerall = var(4) > 0
trigger1 = command = "fwd"
v = 4
value = 1
;persistent = 1

[State 0, VarSet]
type = VarSet
triggerall = (stateNo = [191,199])
trigger1 = var(4) = 0
;trigger2 = var(4) = 12 && command = "fwd"
v = 4
value = 1
;persistent = 1

[State 0, Varadd]
type = Varadd
triggerall = (stateNo = [191,199])
triggerall = var(4) < 13
triggerall = var(4) > 0
trigger1 = command = "back"
v = 4
value = -1
;persistent = 1

[State 0, Varadd]
type = varset
triggerall = (stateNo = [191,199])
trigger1 = command = "back" && var(4) = 0
v = 4
value = 12
;persistent = 1

[State 0, PlaySnd]
type = PlaySnd
triggerall = (stateNo = [191,199])
trigger1 = command = "fwd"
value = S5,6
volumescale = 100

[State 0, PlaySnd]
type = PlaySnd
triggerall = (stateNo = [191,199])
trigger1 = command = "back"
value = S5,5
volumescale = 100

[State 0, Explod]
type = Explod
triggerall = (stateNo = [191,199])
trigger1 = command = "fwd"
anim = 1994
ID = 1994
pos = 15,-30
postype = p1
facing = cond(facing = 1,1,-1)
bindtime = 1
removetime = -2
scale = .09,.09
vel = 2,0
sprpriority = 3
ontop = 1
remappal = 7500,1
ownpal = 1

[State 0, Explod]
type = Explod
triggerall = (stateNo = [191,199])
trigger1 = command = "back"
anim = 1993
ID = 1993
pos = -15,-30
postype = p1
facing = cond(facing = 1,1,-1)
bindtime = 1
removetime = -2
scale = .09,.09
vel = -2,0
