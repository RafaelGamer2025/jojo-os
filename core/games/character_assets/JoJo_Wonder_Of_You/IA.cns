pos = 0,0
facing = -1
sprpriority = 0
ownpal = 1

[state 0]
type = helper
triggerall = numhelper(6200) = 0
trigger1 = Alive
stateno = 6200
id = 6200
pos = 0,0
postype = p1
supermovetime = 0
pausemovetime = 0

[State 0, TargetState]
type = TargetState
triggerall = !Target,ishelper
trigger1 = movehit && (Target,stateno != [15000,15150])
value = 15000
ignorehitpause = 1

[State 0, StopSnd]
type = StopSnd
trigger1 = stateno = [200,620]
channel = 7
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
trigger1 = EnemyNear(var(58)),movetype != H
v = 30
value = 0
ignorehitpause = 1 

[State 0, VarSet]
type = VarSet
trigger1 = stateno != 200 && stateno != 300 && stateno != 400 && stateno != 900
trigger2 = stateno = 400 && prevstateno = 200
trigger3 = stateno = 900 && prevstateno = 200
v = 21
value = 0
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
trigger1 = EnemyNear(var(58)),movetype != H
v = 31
value = 0
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
trigger1 = EnemyNear(var(58)),movetype != H
v = 32
value = 0
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
trigger1 = stateno != 210
v = 20
value = 0
ignorehitpause = 1

[state 0]
type = helper
triggerall = time % 3 = 0
trigger1 = (stateno = 80)
stateno = 8070
id = 8070
pos = 0, 0
postype = p1
supermovetime = 999
pausemovetime = 999

[state 0]
type = angledraw
triggerall = (alive)
trigger1 = cond(stateno = 5000, time <= 12, 1)
value = cond(vel x != 0, - (atan(vel y / vel x) * (const(size.air.back)) / pi), 0)
scale = 1, 1 + (sin((time / 50.0) * (pi / 2)) * 0.0125)
ignorehitpause = 1

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "p2bodydist x = %d, p2bodydist y = %d\nvel x = %d, vel y = %d, ailevel = %d, prevstateno = %d"
params = p2bodydist x, floor(p2bodydist y), vel x, vel y, ailevel, prevstateno
ignorehitpause = 1

[State -2]
type = VarSET
trigger1 = EnemyNear(var(58)),movetype != H
trigger2 = fvar(4) > 1
fvar(4) = 1
ignorehitpause = 1

[State -2]
type = VarAdd
triggerAll = EnemyNear(var(58)),movetype = H
triggerAll = fvar(6) <= 0
triggerAll = fvar(4) > 0.05 
trigger1 = (stateno = [200,210]) && movehit = 1
trigger2 = (stateno = [300,310]) && movehit = 1
trigger3 = (stateno = [400,410]) && movehit = 1
trigger4 = (stateno = [600,620]) && movehit = 1
trigger5 = (helper(1010),stateno = [1010,1013]) && helper(1010),movehit = 1
fvar(4) = -0.06

[State -2]
type = VarAdd
triggerAll = EnemyNear(var(58)),movetype = H
triggerAll = fvar(6) <= 0
triggerAll = fvar(4) > 0.05 
trigger1 = helper(910),stateno = 910 && helper(910),movehit = 1
trigger2 = helper(910),stateno = 911 && helper(910),movehit = 1
trigger3 = (helper(1210),stateno = [1210,1211]) && helper(1210),movehit = 1
fvar(4) = -0.003

[State -2]
type = VarAdd
triggerAll = EnemyNear(var(58)),movetype = H
triggerAll = fvar(6) <= 0
triggerAll = fvar(4) > 0.05 
trigger1 = helper(930),stateno = 931 && helper(930),movehit = 1
trigger2 = helper(930),stateno = 932 && helper(930),movehit = 1
trigger3 = (helper(1210),stateno = [1215,1217]) && helper(1210),movehit = 1
trigger4 = (helper(1210),stateno = [1225,1227]) && helper(1210),movehit = 1
fvar(4) = -0.015

[State -2, AttackMulSet]
type = AttackMulSet
trigger1 = 1
value = fvar(4)+.5*helper(1900),var(16)
ignorehitpause =1 

[State -2, DefenceMulSet]
type = DefenceMulSet
trigger1 = 1
value = 1-cond(numhelper(1310) > 0,.25,0)
ignorehitpause =1 

[State -2, Pause]
type = Pause
triggerall = numhelper(820)
trigger1 = gametime%3=0
time = 1
movetime = 1

[State -2, Explod]
type = Explod
triggerall = teammode = simul
triggerall = numexplod(69) = 0
trigger1 = Cond(teammode = simul,Cond(ID > partner,ID,1,0),0)
anim = 9999
ID = 69
postype = p1
facing = 1
vfacing = 1
bindtime = -1
removetime = -1
removeongethit = 0
