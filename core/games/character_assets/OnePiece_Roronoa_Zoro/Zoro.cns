walk.back = -2
run.fwd  = 0
run.back = 0
jump.neu = 0,-9
jump.back = -4
jump.fwd = 4
runjump.back = 0
runjump.fwd = 0
airjump.neu = 0
airjump.back = 0
airjump.fwd = 0

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .44
stand.friction = .85
crouch.friction = .82

[Quotes]
victory0 = "Con esto seguro mi recompensa ha vuelto a subir."
victory1 = "No lo olvides! Voy a convertirme en el mejor espadachin del mundo!"
victory2 = "Una cicatriz en la espalda es una humillacion para un espadachin."
