; - Var(13) = Bombas Reset // Unguardable
; - Var(14) = Specials Transformaciones
; - Var(15) = Supers Transformaciones

[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = -1
guard.sparkno = -1
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
